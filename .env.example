# Obtain from https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# URL and bearer token for the included FFmpeg processing service.
AUDIO_PROCESSOR_URL=http://127.0.0.1:8788
AUDIO_PROCESSOR_TOKEN=

# Comma-separated workspace user emails allowed to use /admin/music.
ADMIN_EMAILS=

# Conservative defaults permit CC0 and attribution-only CC licenses.
ALLOWED_LICENSE_URL_PREFIXES=https://creativecommons.org/publicdomain/zero/,https://creativecommons.org/licenses/by/
